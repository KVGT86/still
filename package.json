{
  "name": "still-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "desktopName": "io.still.client",
  "description": "Stremio client for desktop, TV and tablet",
  "author": "Still contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/generate-icons.mjs && node scripts/notices.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "package:webos": "node scripts/package-webos.mjs",
    "package:android": "npm run build && node scripts/sync-android.mjs",
    "package:linux": "npm run build && node scripts/package-linux.mjs",
    "desktop": "electron desktop/main.cjs",
    "install:desktop": "node scripts/install-desktop.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "engine:prepare": "node scripts/prepare-engine.mjs",
    "test:torrent": "node scripts/test-torrent.mjs",
    "test:desktop:torrent": "node scripts/test-desktop-torrent.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared server scripts tests e2e"
  },
  "dependencies": {
    "express": "^5.1.0",
    "hls.js": "^1.6.15",
    "lucide-react": "^1.64.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stremio-watched-bitfield": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bencode": "^4.0.1",
    "bittorrent-protocol": "^5.0.9",
    "create-torrent": "^6.1.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "ut_metadata": "^5.0.1",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
